{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dots-depot.invalid/schemas/package.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "type",
    "summary",
    "license",
    "source",
    "tree_sha256",
    "compatibility",
    "requests",
    "dependencies",
    "executables",
    "audit"
  ],
  "properties": {
    "schema": {
      "const": "dots-depot-package/1"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 48,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "type": {
      "enum": [
        "app",
        "skill",
        "recipe",
        "tool",
        "starter"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "path",
        "subtree"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "minLength": 40,
          "maxLength": 64,
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
        },
        "subtree": {
          "type": "string",
          "minLength": 40,
          "maxLength": 64,
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "tree_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dotsys",
        "platform",
        "python"
      ],
      "properties": {
        "dotsys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "platform": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "python": {
          "const": ">=3.12"
        }
      }
    },
    "requests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_read",
        "workspace_write",
        "network",
        "credentials",
        "public_publish",
        "account_changes",
        "paid_services"
      ],
      "properties": {
        "workspace_read": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "workspace_write": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "network": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^https://[A-Za-z0-9.-]+$"
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "credentials": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "public_publish": {
          "type": "boolean"
        },
        "account_changes": {
          "type": "boolean"
        },
        "paid_services": {
          "type": "boolean"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "executables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "audit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
    }
  }
}

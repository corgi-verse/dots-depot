{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "packages"
  ],
  "properties": {
    "schema": {
      "const": "dots-depot-catalog/1"
    },
    "mode": {
      "enum": [
        "trusted",
        "synthetic"
      ]
    },
    "packages": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "name",
          "type",
          "summary",
          "tree_sha256",
          "manifest_sha256",
          "audit_sha256",
          "archive_sha256",
          "synthetic"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 96,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "minLength": 5,
            "maxLength": 48,
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "enum": [
              "app",
              "skill",
              "recipe",
              "tool",
              "starter"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320
          },
          "tree_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "manifest_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "audit_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "archive_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "synthetic": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
